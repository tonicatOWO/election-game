# Campaign Sim — Frontend builder
# Builds Svelte SPA into static files for nginx

FROM oven/bun:latest AS web-builder

WORKDIR /app

COPY package.json bun.lock ./
COPY shared/package.json ./shared/
COPY web/package.json ./web/

RUN bun install --frozen-lockfile

COPY shared/ ./shared/
COPY web/ ./web/

# Build-time env (defaults match server .env)
ARG VITE_API_PREFIX=/api
ARG VITE_WS_PATH=/ws

RUN bun --filter web build
